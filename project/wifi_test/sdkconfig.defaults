# WiFi Test + Camera

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_CHIP_REV_MIN=0
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# Chip revision (v1.3 < v3.0)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

# Keep BNO085 UART RX serviceable while CSI/ISP/JPEG cache-sensitive DMA is active.
CONFIG_UART_ISR_IN_IRAM=y

# PSRAM (200M requires experimental features gate)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# Camera: ESP32-P4 dedicated clock router supplies OV5647 XCLK on GPIO40.
# Do not consume LEDC: all LEDC channels/timers remain available for actuator
# hardware after its SDIO GPIO conflict is physically resolved.
CONFIG_CAMERA_XCLK_USE_LEDC=n
CONFIG_CAMERA_XCLK_USE_ESP_CLOCK_ROUTER=y
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y

# WiFi / ESP-Hosted SDIO co-processor (ESP32-C6)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# C6 SDIO at 20 MHz: verified isolation says each peripheral is sound, but
# their 40 MHz simultaneous operation intermittently disrupts BNO085 RVC.
# 20 MHz is the smallest transport-layer mitigation before changing hardware.
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=20
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=20
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=54

# Performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# TCP video throughput: a single 800x800 gray JPEG is about 20 KB.  The
# 5,760-byte defaults require several ACK windows for each frame, causing
# send-side backpressure.  These values remain below the non-window-scaled
# 65,535-byte limit and are sized for the P4's available PSRAM.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=25
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

# ESP-Hosted C6 Wi-Fi queues: 12 is within the component's documented
# AMPDU recommendation (9-12), while larger dynamic queues absorb TCP bursts.
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_TX_BA_WIN=12
CONFIG_WIFI_RMT_RX_BA_WIN=12
